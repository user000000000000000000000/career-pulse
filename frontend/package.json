{
  "name": "career-pulse-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CareerPulse — платформа карьерной диагностики (фронтенд)",
  "scripts": {
    "dev": "vite --base=/",
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 5174 --strictPort",
    "build:demo": "vite build --mode demo",
    "build:demo:vercel": "vite build --mode demo --base=/ --outDir dist-demo-vercel && node scripts/check-demo-artifact.mjs",
    "build:demo:prebuilt": "vite build --mode demo --base=/ --outDir dist-demo-vercel && node scripts/check-demo-artifact.mjs && node scripts/prepare-demo-prebuilt.mjs",
    "preview:demo": "vite preview --mode demo --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build",
    "build:prod": "vite build --base=/",
    "preview": "vite preview",
    "check:arch": "steiger ./src",
    "test": "node src/pages/diagnostic/model/scoring/scoring.test.mjs && node src/entities/profession/model.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@vitejs/plugin-react": "^4.3.1",
    "steiger": "^0.6.0",
    "vite": "^5.4.0"
  }
}
