# ─────────────────────────────────────────────
# CareerPulse — переменные окружения (фронтенд)
# Скопируйте этот файл в .env и подставьте значения.
# ВНИМАНИЕ: всё с префиксом VITE_ попадает в клиентский бандл
# и видно всем. Сюда кладём ТОЛЬКО публичные ключи.
# ─────────────────────────────────────────────

# Supabase — публичные значения (безопасно для фронтенда)
VITE_SUPABASE_URL=https://ваш-проект.supabase.co
VITE_SUPABASE_ANON_KEY=ваш-anon-public-ключ

# URL Edge Function анализа (обычно: $VITE_SUPABASE_URL/functions/v1/analyze-test)
# Можно не указывать — вычислится автоматически из VITE_SUPABASE_URL.
VITE_ANALYZE_FUNCTION_URL=

# ─────────────────────────────────────────────
# ❗ Ключ DeepSeek СЮДА НЕ КЛАДЁМ.
# Он задаётся как секрет Edge Function на стороне Supabase:
#   supabase secrets set DEEPSEEK_API_KEY=sk-...
# и читается через Deno.env внутри функции. В браузер не попадает.
# ─────────────────────────────────────────────
